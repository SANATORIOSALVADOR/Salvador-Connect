{
  "name": "salvador-connect",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Sistema interno del Sanatorio del Salvador",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('Usá pnpm'); process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "pnpm -r --filter \"./artifacts/api-server\" --filter \"./lib/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed-sectors": "pnpm --filter @workspace/scripts run seed-sectors",
    "dev:api": "pnpm --filter @workspace/api-server run dev"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
