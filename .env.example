# =============================================================================
# Salvador-Connect — producción / staging
# Copiar a .env y completar. NUNCA subir .env a git.
# =============================================================================

# Postgres
POSTGRES_USER=sanatorio
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE
POSTGRES_DB=sanatorio_db
# Bind de Postgres (solo localhost por defecto)
POSTGRES_BIND=127.0.0.1:5432

# API (interno; el acceso público va por web/nginx)
API_BIND=127.0.0.1:5000

# Web (LAN o 0.0.0.0). Con el puerto 80 se entra sin escribir puerto.
# Server prueba: 172.20.1.134:8085 → WEB_BIND=172.20.1.134:8085
WEB_BIND=0.0.0.0:8080

# Nombre interno (http://sanatorio.salvador.connect) — lo completa: bash scripts/configurar-nombre.sh
# Ver docs/NOMBRE_LOCAL.md. COMPOSE_PROFILES=dns levanta el DNS interno (servicio "dns").
# SITE_NAME=sanatorio.salvador.connect
# SERVER_IP=172.20.1.134
# COMPOSE_PROFILES=dns
# DNS_UPSTREAM_1=8.8.8.8
# DNS_UPSTREAM_2=1.1.1.1

NODE_ENV=production

# Superadmin inicial: SOLO se usa si no existe ningún superadmin activo.
# Mín. 10 caracteres. Después de crear el usuario podés borrar esta línea.
# Para recuperar el acceso: bash scripts/reset-admin.sh
BOOTSTRAP_ADMIN_PASSWORD=

# Backups automáticos (servicio "backup"): carpeta, días que se guardan y hora del backup diario.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
