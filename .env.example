# =============================================================================
# Salvador-Connect — producción / staging
# Copiar a .env y completar. NUNCA subir .env a git.
# =============================================================================

# Postgres
POSTGRES_USER=sanatorio
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE
POSTGRES_DB=sanatorio_db
# Bind de Postgres (solo localhost por defecto)
POSTGRES_BIND=127.0.0.1:5432

# API (interno; el acceso público va por web/nginx)
API_BIND=127.0.0.1:5000

# Web (LAN o 0.0.0.0)
# Server prueba: 172.20.1.134:8085 → WEB_BIND=172.20.1.134:8085
WEB_BIND=0.0.0.0:8080

NODE_ENV=production
